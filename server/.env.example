# AARAA Infrastructure – SMTP Configuration
# Rename this file to .env and fill in your credentials

# SMTP Host (e.g., smtp.gmail.com for Gmail, smtp.office365.com for Outlook)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Use TLS (true/false)
SMTP_SECURE=false

# Sender email address
EMAIL_USER=info@aaraainfrastructure.com

# App password (NOT your regular password – generate from Google Account > Security > App Passwords)
EMAIL_PASS=YOUR_APP_PASSWORD_HERE

# Recipient email for all form submissions
RECIPIENT_EMAIL=info@aaraainfrastructure.com

# Server port
PORT=3001

# Allowed origins (comma-separated, no trailing slash)
ALLOWED_ORIGINS=https://www.aaraainfrastructure.com,http://localhost:5500,http://127.0.0.1:5500
