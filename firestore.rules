rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Restrict all database collections exclusively to verified AARAA administrators
    match /{document=**} {
      allow read, write: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.auth.token.email.matches('.*@aaraainfrastructure\\.com$');
    }
  }
}
