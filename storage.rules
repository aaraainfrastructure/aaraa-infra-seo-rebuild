rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Lock down all storage folders. Read and write are restricted to authenticated AARAA administrators.
    match /{allPaths=**} {
      allow read, write: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.auth.token.email.matches('.*@aaraainfrastructure\\.com$');
    }
  }
}
